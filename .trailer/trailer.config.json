{
  "$schema": "https://raw.githubusercontent.com/Dileep2896/trailer/main/engine/schema/trailer.schema.json",
  "version": 1,
  "projectName": "trailer",
  "tagline": "Point it at your repo. Get a narrated film.",
  "repoUrl": "https://github.com/Dileep2896/trailer",
  "link": {
    "text": "github.com/Dileep2896/trailer",
    "url": "https://github.com/Dileep2896/trailer"
  },
  "aspect": "16:9",
  "targetSeconds": 60,
  "fitSeconds": 62,
  "narration": {
    "person": "third"
  },
  "voice": {
    "provider": "deepgram",
    "model": "aura-2-hermes-en",
    "speed": 1.0
  },
  "meta": {
    "useCase": "explainer",
    "format": "F18 Speedrun",
    "formatWhy": "The promise is a run from repo to film: each split is one step a person would otherwise do by hand (read, script, rebuild the UI, voice, review), timed by the narrator's words instead of a stopwatch.",
    "tone": "quick, wry, confident",
    "sources": [
      {
        "claim": "20 story formats",
        "source": "README.md:46; skills/trailer/references/formats.md (F01 to F20)"
      },
      {
        "claim": "5 skills",
        "source": "skills/ (trailer, trailer-launch, trailer-jobhunt, trailer-hackathon, trailer-shorts)"
      },
      {
        "claim": "3 aspects: 16:9, 9:16, 1:1 from one config",
        "source": "README.md:57"
      },
      {
        "claim": "captions burned in plus .srt and .vtt",
        "source": "README.md:60"
      },
      {
        "claim": "renders locally, nothing uploaded",
        "source": "README.md:66"
      },
      {
        "claim": "this film was made by trailer from its own repo",
        "source": ".trailer/trailer.config.json (this file)"
      }
    ]
  },
  "theme": {
    "mode": "dark",
    "bg": "#07080c",
    "surface": "#11131b",
    "ink": "#f2f4f8",
    "muted": "#9aa1b2",
    "accent": "#c8ff2e",
    "accent2": "#ff4fd8",
    "warn": "#ff5a4f",
    "fonts": {
      "display": "Unbounded",
      "ui": "Instrument Sans",
      "mono": "Share Tech Mono"
    },
    "displayCase": "none",
    "displayWeight": 800,
    "tracking": -0.035,
    "radius": 14,
    "background": "scanlines",
    "chrome": "terminal",
    "transition": "glitch",
    "motion": "snappy",
    "camera": "push",
    "type": "stacked",
    "motif": "scoreboard",
    "grain": 0.05,
    "rhythm": "mono"
  },
  "app": {
    "font": "Inter",
    "mono": "JetBrains Mono",
    "bg": "#0b111c",
    "surface": "#151d2b",
    "ink": "#eef2f6",
    "muted": "#a3aebb",
    "accent": "#3b82f6",
    "onAccent": "#ffffff",
    "good": "#34d399",
    "bad": "#f87171",
    "warn": "#fbbf24",
    "radius": 10,
    "size": 30,
    "dark": true
  },
  "captions": {
    "position": "bottom",
    "style": "box",
    "size": 50,
    "fontRole": "ui",
    "weight": 700,
    "maxWords": 6
  },
  "music": {
    "bpm": 128,
    "mood": "driving"
  },
  "scenes": [
    {
      "id": "open",
      "type": "title",
      "layout": "hud",
      "transition": "cut",
      "lines": [
        "$ git push --tags        v1.0 shipped",
        "TODO  a demo video for the launch"
      ],
      "eyebrow": "FRIDAY, 17:40",
      "title": "Now make the demo.",
      "accent": "demo",
      "say": "Friday. The feature ships. Now someone has to make the demo.",
      "breath": 0.6,
      "firstFrame": "settled"
    },
    {
      "id": "takes",
      "type": "calendar",
      "transition": "flash",
      "pages": [
        {
          "day": "TAKE",
          "date": "1",
          "note": "missed the menu",
          "at": "record"
        },
        {
          "day": "TAKE",
          "date": "2",
          "note": "wrong tab open",
          "at": "miss"
        },
        {
          "day": "TAKE",
          "date": "3",
          "note": "music too loud",
          "at": "start"
        },
        {
          "day": "TAKE",
          "date": "4",
          "note": "a button moved",
          "at": "over"
        }
      ],
      "sfx": [
        {
          "at": "record",
          "sound": "beep"
        }
      ],
      "say": "So you hit record, miss a click, and start over."
    },
    {
      "id": "feed",
      "type": "split",
      "mode": "versus",
      "divider": "line",
      "transition": "whip",
      "left": {
        "label": "WHAT SHIPS",
        "tone": "bad",
        "title": "demo-final-v3.mov",
        "elements": [
          {
            "type": "card",
            "icon": "television",
            "title": "Screen recording",
            "body": "Clicks and a cursor over stock music."
          },
          {
            "type": "chips",
            "items": [
              {
                "text": "no captions",
                "tone": "bad"
              },
              {
                "text": "no story",
                "tone": "bad"
              },
              {
                "text": "stale next release",
                "tone": "warn"
              }
            ]
          }
        ],
        "app": {
          "size": 30
        }
      },
      "right": {
        "label": "THE FEED",
        "tone": "neutral",
        "title": "Muted autoplay",
        "elements": [
          {
            "type": "list",
            "items": [
              {
                "title": "launch video",
                "sub": "screen recording, music only",
                "badge": {
                  "text": "skipped",
                  "tone": "bad"
                }
              },
              {
                "title": "another launch video",
                "sub": "screen recording, music only",
                "badge": {
                  "text": "skipped",
                  "tone": "bad"
                }
              },
              {
                "title": "yours",
                "sub": "screen recording, music only",
                "badge": {
                  "text": "skipped",
                  "tone": "bad"
                },
                "at": "scrolls"
              }
            ]
          }
        ],
        "verdict": {
          "text": "SCROLLED PAST",
          "at": "past",
          "tone": "bad",
          "size": 76
        },
        "app": {
          "size": 30
        }
      },
      "say": "What ships is a screen recording with music. No story. The feed scrolls past.",
      "breath": 0.9
    },
    {
      "id": "turn",
      "type": "kinetic",
      "turn": true,
      "transition": "glitch",
      "captions": "off",
      "layout": "center",
      "beats": [
        {
          "text": "Enter trailer.",
          "accent": "trailer",
          "fx": "punch",
          "at": 0,
          "until": "point"
        },
        {
          "text": "Repo in. Film out.",
          "accent": "Film",
          "fx": "stamp",
          "at": "point"
        }
      ],
      "say": "Enter trailer. Point it at your repo; it makes the film.",
      "breath": 0.5
    },
    {
      "id": "read",
      "type": "ui",
      "frame": "app",
      "title": "claude  ~/your-app",
      "transition": "zoom",
      "width": 1180,
      "sideAlign": "right",
      "side": {
        "eyebrow": "SPLIT 1  READ",
        "title": "Reads it. Never runs it.",
        "accent": "Never",
        "points": [
          {
            "text": "README, routes, seed data",
            "at": "reads"
          },
          {
            "text": "Who hurts, what breaks",
            "at": "hurts"
          },
          {
            "text": "1 format of 20",
            "at": "formats"
          }
        ]
      },
      "elements": [
        {
          "type": "code",
          "id": "term",
          "lines": [
            {
              "text": "> /trailer:new",
              "at": 0
            },
            {
              "text": "  Reading README, routes, theme, seed data",
              "at": "reads"
            },
            {
              "text": "  Wrote brief.md   who hurts, what breaks",
              "at": "hurts"
            },
            {
              "text": "  Shortlist  F18 Speedrun, F16, F04",
              "at": "picks"
            },
            {
              "text": "  Picked     F18 Speedrun   1 of 20",
              "at": "formats"
            },
            {
              "text": "  Wrote script.md  a source for every number",
              "at": "-0.6s"
            }
          ],
          "highlight": [
            5
          ]
        }
      ],
      "camera": [
        {
          "at": "picks",
          "focus": "term.line4",
          "zoom": 1.35
        },
        {
          "at": "-0.4s",
          "reset": true
        }
      ],
      "highlight": [
        {
          "at": "formats",
          "target": "term.line4"
        }
      ],
      "notes": [
        {
          "at": "formats",
          "target": "term.line4",
          "text": "picked to fit the problem",
          "side": "bottom"
        }
      ],
      "say": "One command. It reads your code, finds who hurts, and picks one of 20 story formats."
    },
