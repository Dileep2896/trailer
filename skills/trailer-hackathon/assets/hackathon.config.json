    {
      "id": "proof",
      "type": "metric",
      "style": "ring",
      "transition": "zoom",
      "eyebrow": "Test set · photos in the repo",
      "metrics": [
        {
          "label": "Missing ramps caught",
          "from": 0,
          "to": 37,
          "max": 39,
          "suffix": " of 39",
          "at": "caught"
        }
      ],
      "breath": 1,
      "say": "On its test photos, it caught 37 of 39 missing ramps."
    },
