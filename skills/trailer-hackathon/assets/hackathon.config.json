      "spotlight": [
        {
          "at": "blocked",
          "target": "curbs.item1"
        }
      ],
      "notes": [
        {
          "at": "blocked",
          "target": "curbs.item1",
          "text": "Missing ramp, flagged",
          "side": "bottom"
        }
      ],
      "breath": 0.9,
      "say": "Point a phone at the corner. Every curb gets tagged: ramp, no ramp, or blocked."
    },
