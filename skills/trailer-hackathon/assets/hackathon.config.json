  "scenes": [
    {
      "id": "problem",
      "type": "title",
      "layout": "hud",
      "title": "RUN 01 · CURB CHECK",
      "lines": [
        "ROUTE   home → clinic",
        "RAMPS   unknown",
        "MAP     shows none"
      ],
      "breath": 0.5,
      "say": "Four curbs on Maria's route to the clinic have no ramp. She finds out at the curb."
    },
    {
      "id": "turn",
      "type": "kinetic",
      "turn": true,
      "transition": "flash",
      "captions": "off",
      "beats": [
        {
          "text": "Rampwise",
          "accent": "Rampwise",
          "fx": "punch",
          "at": 0
        },
        {
          "text": "maps them first.",
          "fx": "rise",
          "at": "maps"
        }
      ],
      "breath": 0.4,
      "say": "Rampwise maps every curb before she leaves."
    },
    {
      "id": "demo-scan",
      "type": "ui",
      "frame": "phone",
      "transition": "push",
      "side": {
        "eyebrow": "Split 1",
        "title": "Snap the corner",
        "accent": "Snap",
        "points": [
          {
            "text": "Ramp, no ramp, blocked",
            "at": "tagged"
          }
        ]
      },
      "elements": [
        {
          "type": "header",
          "id": "head",
          "title": "Elm St & 3rd",
          "sub": "Scan each corner"
        },
        {
          "type": "button",
          "id": "scan",
          "label": "Scan corner"
        },
        {
          "type": "list",
          "id": "curbs",
          "at": "tagged",
          "items": [
            {
              "title": "NE corner",
              "badge": {
                "text": "Ramp",
                "tone": "good"
              }
            },
            {
              "title": "NW corner",
              "badge": {
                "text": "No ramp",
                "tone": "bad"
              },
              "tone": "bad"
            },
            {
              "title": "SW corner",
              "badge": {
                "text": "Blocked",
                "tone": "warn"
              },
              "tone": "warn"
            },
            {
              "title": "SE corner",
              "badge": {
                "text": "Ramp",
                "tone": "good"
              }
            }
          ]
        }
      ],
      "cursor": [
        {
          "at": "Point",
          "to": "scan"
