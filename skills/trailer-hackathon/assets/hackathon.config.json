  "narration": {
    "person": "third"
  },
  "meta": {
    "useCase": "hackathon",
    "format": "F18 Speedrun",
    "formatWhy": "[FILL: why the format fits, e.g. the core loop is three quick steps (scan, map, route), so each step reads as a split of one run]",
    "tone": "fast, warm, plain",
    "sources": [
      {
        "claim": "4 curbs without a ramp on the route",
        "source": "[FILL: seed data file:line]"
      },
      {
        "claim": "37 of 39 missing ramps caught",
        "source": "[FILL: test fixture or eval output, file:line]"
      }
    ]
  },
  "forbiddenTerms": [],
