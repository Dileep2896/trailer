{
  "$schema": "https://raw.githubusercontent.com/Dileep2896/trailer/main/engine/schema/trailer.schema.json",
  "version": 1,
  "projectName": "Tinlark",
  "tagline": "Hears the scheduled job that never ran.",
  "link": {
    "text": "tinlark.example",
    "url": "https://tinlark.example"
  },
  "aspect": "9:16",
  "targetSeconds": 28,
  "fitSeconds": 30,
  "narration": {
    "person": "third"
  },
  "voice": {
    "provider": "deepgram",
    "model": "aura-2-hermes-en",
    "speed": 1
  },
  "forbiddenTerms": [
    "revolutionary",
    "game-changing",
    "game-changer",
    "seamless",
    "seamlessly",
    "supercharge",
    "unleash",
    "cutting-edge",
    "next-generation",
    "world-class",
    "blazing",
    "excited to announce"
  ],
  "meta": {
    "useCase": "shorts",
    "format": "One Question",
    "formatWhy": "[FILL: one sentence on why the hook, one product move and one number fit this problem]",
    "tone": "fast, plain, concrete",
    "notes": "Starter for a fictional product. Replace every name, number, source, token and line from brief.md, then delete this note.",
    "sources": [
      {
        "claim": "a skipped run was flagged in 2 minutes",
        "source": "[FILL: test or benchmark file:line]"
      },
      {
        "claim": "the backup stopped 4 days before anyone noticed",
        "source": "[FILL: seed data or public evidence, attributed generically]"
      }
    ]
  },
  "theme": {
    "mode": "dark",
    "bg": "#0f1417",
    "surface": "#172026",
    "ink": "#eef3f1",
    "muted": "#93a3a0",
    "accent": "#2dd4bf",
    "accent2": "#f59e0b",
    "warn": "#f87171",
    "fonts": {
      "display": "Space Grotesk",
      "ui": "Inter",
      "mono": "JetBrains Mono"
    },
    "displayCase": "none",
    "displayWeight": 700,
    "tracking": -0.03,
    "radius": 16,
    "background": "noise-glow",
    "chrome": "minimal",
    "transition": "cut",
    "motion": "snappy",
    "camera": "drift",
    "type": "giant-kinetic",
    "motif": "none",
    "grain": 0.04,
    "rhythm": "mono"
  },
  "app": {
    "font": "Geist",
    "mono": "Geist Mono",
    "bg": "#0f1115",
    "surface": "#161a20",
    "subtle": "#1d222a",
    "ink": "#e8ecf1",
    "muted": "#8b95a3",
    "border": "#262c35",
    "accent": "#2dd4bf",
    "good": "#4ade80",
    "bad": "#f87171",
    "warn": "#fbbf24",
    "radius": 8,
    "size": 24,
    "dark": true
  },
  "captions": {
    "position": "center-low",
    "style": "box",
    "size": 68,
    "weight": 800,
    "case": "none",
    "maxWords": 3
  },
  "music": {
    "bpm": 120,
    "mood": "driving"
  },
  "scenes": [
    {
      "id": "hook",
      "type": "kinetic",
      "lead": 0,
      "transition": "cut",
      "beats": [
        {
          "text": "The backup stopped.",
          "accent": "stopped",
          "fx": "punch",
          "at": 0
        },
        {
          "text": "4 days ago.",
          "accent": "4 days",
          "fx": "mask",
          "at": "four"
        }
      ],
      "say": "The nightly backup stopped four days ago."
    },
    {
      "id": "silence",
      "type": "ui",
      "frame": "panel",
      "captions": "top",
      "elements": [
        {
          "type": "code",
          "id": "log",
          "file": "/var/log/cron.log",
          "lines": [
            {
              "text": "Thu 02:00  backup.sh  exit 0",
              "at": 0
            },
            {
              "text": "Fri        (nothing)",
              "at": "ran"
            },
            {
              "text": "Sat        (nothing)",
              "at": "skipped"
            },
            {
              "text": "Sun        (nothing)",
              "at": "error"
            }
          ]
        }
      ],
      "highlight": [
        {
          "at": "skipped",
          "target": "log.line1"
        }
      ],
      "notes": [
        {
          "at": "error",
          "target": "log.line3",
          "text": "No error. No alert.",
          "side": "bottom"
        }
      ],
      "say": "Logs only list jobs that ran. A skipped job leaves no error.",
      "breath": 0.4
    },
    {
      "id": "turn",
      "type": "kinetic",
      "turn": true,
      "transition": "zoom",
      "captions": "off",
      "beats": [
        {
          "text": "Enter Tinlark.",
          "accent": "Tinlark",
          "fx": "punch",
          "at": 0
        }
      ],
      "say": "Enter Tinlark.",
      "breath": 0.4
    },
    {
      "id": "demo",
      "type": "ui",
      "frame": "browser",
      "url": "tinlark.example/jobs",
      "poster": true,
      "side": {
        "eyebrow": "One line per job",
        "title": "Late means red",
        "accent": "red",
        "points": [
          {
            "text": "1 minute past schedule",
            "at": "minute"
          }
        ]
      },
      "elements": [
        {
          "type": "header",
          "id": "head",
          "title": "Jobs",
          "sub": "3 scheduled · prod"
        },
        {
          "type": "table",
          "id": "jobs",
          "columns": [
            "Job",
            "Last ping",
            "Status"
          ],
          "widths": [
            2,
            1.3,
            1.2
          ],
          "rows": [
            [
              "nightly-backup",
              "02:00:41",
              {
                "text": "On time",
                "tone": "good",
                "badge": true
              }
            ],
            [
              "invoice-export",
              "09:15:03",
              {
                "text": "On time",
                "tone": "good",
                "badge": true
              }
            ],
            [
              "cache-warm",
              "09:20:12",
              {
                "text": "On time",
                "tone": "good",
                "badge": true
              }
            ]
          ],
          "states": [
            {
              "at": "red",
              "row": 0,
              "set": {
                "cells": [
                  "nightly-backup",
                  "missed",
                  {
                    "text": "Late",
                    "tone": "bad",
                    "badge": true
                  }
                ],
                "tone": "bad"
              }
            }
          ]
        }
      ],
      "spotlight": [
        {
          "at": "red",
          "target": "jobs.row0"
        }
      ],
      "say": "Each job pings Tinlark when it finishes. Miss a ping, and the job turns red 1 minute past its schedule."
    },
    {
      "id": "proof",
      "type": "metric",
      "style": "ring",
      "eyebrow": "On the demo fleet",
      "metrics": [
        {
          "label": "Minutes to flag a skipped run",
          "from": 0,
          "to": 2,
          "max": 10,
          "at": "flagged"
        }
      ],
      "say": "On the demo fleet, a skipped run was flagged in 2 minutes."
    },
    {
      "id": "end",
      "type": "outro",
      "layout": "card",
      "transition": "dissolve",
      "loop": true,
      "say": "Tinlark. Hear the job that never ran."
    }
  ]
}
