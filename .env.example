# trailer environment variables. Never commit a filled-in copy.
#
# DEEPGRAM_API_KEY is read from the environment first, then from <project>/.trailer/.env,
# then from <project>/.env, so you can copy this file to either place.
# The TRAILER_* and REMOTION_* variables are read from the environment only: export them
# in your shell.

# Deepgram API key for the natural narrator (Aura-2 voice + Nova-3 word timings).
# Optional: without it, drafts use macOS `say`, Linux `espeak-ng`, or silence.
DEEPGRAM_API_KEY=

# Aura-2 voice model (default aura-2-hermes-en). Any aura-2-<name>-<lang> model works.
# TRAILER_VOICE=aura-2-hermes-en

# Force a voice provider: deepgram | say | none (a silent draft) | text (no voice: music,
# sound effects and on-screen text, free)
# TRAILER_VOICE_ENGINE=

# Where the engine keeps its runtime install and caches (default ~/.cache/trailer).
# TRAILER_HOME=

# A Chrome or headless-shell executable to render with, instead of Remotion's download.
# REMOTION_BROWSER=
